<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ (API 31+) backup/transfer rules.
   cookies.txt (login session tokens) cloud backup aur device-transfer dono se
   EXCLUDE — new phone ke liye app ka apna Backup/Restore feature use hota hai.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cookies.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cookies.txt" />
    </device-transfer>
</data-extraction-rules>